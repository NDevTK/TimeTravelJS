+/* Like find_line_num, but also reports the bytecode range [*ppc_lo, *ppc_hi)
+   over which the resolved line holds, so the dispatch loop can skip hook
+   checks while execution stays on the same line. */
+static int tt_find_line(JSFunctionBytecode *b, uint32_t pc_value,
+                        int *pcol_num, uint32_t *ppc_lo, uint32_t *ppc_hi)
+{
+    const uint8_t *p_end, *p;
+    int new_line_num, line_num, v, ret, new_col_num, col_num;
+    uint32_t val, pc, prev_pc;
+    unsigned int op;
+
+    *ppc_lo = 0;
+    *ppc_hi = UINT32_MAX;
+    if (!b->has_debug || !b->debug.pc2line_buf)
+        goto fail;
+
+    p = b->debug.pc2line_buf;
+    p_end = p + b->debug.pc2line_len;
+
+    ret = get_leb128(&val, p, p_end);
+    if (ret < 0)
+        goto fail;
+    p += ret;
+    line_num = val + 1;
+
+    ret = get_leb128(&val, p, p_end);
+    if (ret < 0)
+        goto fail;
+    p += ret;
+    col_num = val + 1;
+
+    pc = 0;
+    prev_pc = 0;
+    while (p < p_end) {
+        op = *p++;
+        if (op == 0) {
+            ret = get_leb128(&val, p, p_end);
+            if (ret < 0)
+                goto fail;
+            pc += val;
+            p += ret;
+            ret = get_sleb128(&v, p, p_end);
+            if (ret < 0)
+                goto fail;
+            p += ret;
+            new_line_num = line_num + v;
+        } else {
+            op -= PC2LINE_OP_FIRST;
+            pc += (op / PC2LINE_RANGE);
+            new_line_num = line_num + (op % PC2LINE_RANGE) + PC2LINE_BASE;
+        }
+        ret = get_sleb128(&v, p, p_end);
+        if (ret < 0)
+            goto fail;
+        p += ret;
+        new_col_num = col_num + v;
+
+        if (pc_value < pc) {
+            *ppc_lo = prev_pc;
+            *ppc_hi = pc;
+            goto done;
+        }
+        prev_pc = pc;
+        line_num = new_line_num;
+        col_num = new_col_num;
+    }
+    *ppc_lo = prev_pc;
+ done:
+    *pcol_num = col_num;
+    return line_num;
+ fail:
+    *pcol_num = 0;
+    return 0;
+}
