+        sizeof(JSVarRef *) * ref_count;
+    size = (size + 15) & ~(size_t)15;
+    base = rt->tt_arena_top;
+    if (unlikely(size > (size_t)(rt->tt_arena_limit - base)))
+        return NULL;
+    rt->tt_arena_top = base + size;
+    sf = (JSStackFrame *)base;
+    *pvals = (JSValue *)(sf + 1);
+    return sf;
+}
