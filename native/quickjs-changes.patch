+/* TimeTravelJS debugger API ---------------------------------------------- */
+
+void JS_TTSetStepHandler(JSRuntime *rt, JSTTStepHandler *handler, void *opaque)
+{
+    rt->tt_step_handler = handler;
+    rt->tt_step_opaque = opaque;
+}
+
+void JS_TTEnableStep(JSRuntime *rt, JS_BOOL enable)
+{
+    rt->tt_step_enabled = enable;
+}
+
+JS_BOOL JS_TTStepEnabled(JSRuntime *rt)
+{
+    return rt->tt_step_enabled;
+}
+
+void JS_TTSetVirtualTime(double ms, JS_BOOL enabled)
+{
+    tt_vtime = ms;
+    tt_vtime_enabled = enabled;
+}
+
+double JS_TTGetVirtualTime(void)
+{
+    return tt_vtime;
+}
+
+static JSFunctionBytecode *tt_frame_bytecode(JSStackFrame *sf)
+{
+    JSObject *p;
+    if (JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return NULL;
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (p->class_id != JS_CLASS_BYTECODE_FUNCTION)
+        return NULL;
+    return p->u.func.function_bytecode;
+}
+
+JSValue JS_TTBacktrace(JSContext *ctx)
+{
+    JSRuntime *rt = ctx->rt;
+    JSStackFrame *sf;
+    JSValue arr, entry;
+    uint32_t idx = 0;
+    int line, col;
+
+    arr = JS_NewArray(ctx);
+    if (JS_IsException(arr))
+        return arr;
+    for (sf = rt->current_stack_frame; sf; sf = sf->prev_frame) {
+        JSFunctionBytecode *b = tt_frame_bytecode(sf);
+        entry = JS_NewObject(ctx);
+        if (JS_IsException(entry))
+            break;
+        if (b) {
+            line = 0;
+            col = 0;
+            if (sf->cur_pc)
+                line = find_line_num(ctx, b, sf->cur_pc - b->byte_code_buf, &col);
+            JS_DefinePropertyValueStr(ctx, entry, "name",
+                                      b->func_name == JS_ATOM_NULL
+                                          ? JS_NewString(ctx, "")
+                                          : JS_AtomToString(ctx, b->func_name),
+                                      JS_PROP_C_W_E);
+            JS_DefinePropertyValueStr(ctx, entry, "line", JS_NewInt32(ctx, line), JS_PROP_C_W_E);
+            JS_DefinePropertyValueStr(ctx, entry, "col", JS_NewInt32(ctx, col), JS_PROP_C_W_E);
+        } else {
+            JS_DefinePropertyValueStr(ctx, entry, "name", JS_NewString(ctx, "(native)"), JS_PROP_C_W_E);
+            JS_DefinePropertyValueStr(ctx, entry, "line", JS_NewInt32(ctx, 0), JS_PROP_C_W_E);
+            JS_DefinePropertyValueStr(ctx, entry, "col", JS_NewInt32(ctx, 0), JS_PROP_C_W_E);
+        }
+        JS_DefinePropertyValueUint32(ctx, arr, idx++, entry, JS_PROP_C_W_E);
+    }
+    return arr;
+}
+
+/* add name -> value unless the name is internal or exists already */
+static void tt_add_local(JSContext *ctx, JSValueConst obj, JSValueConst tdz_arr,
+                         uint32_t *tdz_count, JSAtom name_atom, JSValueConst val)
+{
+    const char *name;
+    if (name_atom == JS_ATOM_NULL)
+        return;
+    name = JS_AtomToCString(ctx, name_atom);
+    if (!name)
+        return;
+    if (name[0] == '\0' || name[0] == '<' || name[0] == '#') {
+        JS_FreeCString(ctx, name);
+        return;
+    }
+    if (JS_VALUE_GET_TAG(val) == JS_TAG_UNINITIALIZED) {
+        JS_DefinePropertyValueUint32(ctx, (JSValue)tdz_arr, (*tdz_count)++,
+                                     JS_NewString(ctx, name), JS_PROP_C_W_E);
+    } else {
+        int present = JS_HasProperty(ctx, obj, name_atom);
+        if (present <= 0) {
+            JS_DefinePropertyValueStr(ctx, (JSValue)obj, name,
+                                      JS_DupValue(ctx, val), JS_PROP_C_W_E);
+        }
+    }
+    JS_FreeCString(ctx, name);
+}
+
+JSValue JS_TTLocals(JSContext *ctx, int level)
+{
+    JSRuntime *rt = ctx->rt;
+    JSStackFrame *sf;
+    JSFunctionBytecode *b;
+    JSObject *p;
+    JSValue obj, tdz;
+    uint32_t tdz_count = 0;
+    int i;
+
+    /* find the requested bytecode frame */
+    sf = rt->current_stack_frame;
+    while (sf && (tt_frame_bytecode(sf) == NULL))
+        sf = sf->prev_frame;
+    while (sf && level > 0) {
+        sf = sf->prev_frame;
+        while (sf && (tt_frame_bytecode(sf) == NULL))
+            sf = sf->prev_frame;
+        level--;
+    }
+    if (!sf)
+        return JS_NewObject(ctx);
+    b = tt_frame_bytecode(sf);
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+
+    obj = JS_NewObject(ctx);
+    if (JS_IsException(obj))
+        return obj;
+    tdz = JS_NewArray(ctx);
+
+    /* arguments and local variables (names from the debug vardefs) */
+    if (b->vardefs) {
+        int arg_named = b->arg_count;
+        if (sf->arg_buf) {
+            for (i = 0; i < arg_named && i < sf->arg_count; i++)
+                tt_add_local(ctx, obj, tdz, &tdz_count,
+                             b->vardefs[i].var_name, sf->arg_buf[i]);
+        }
+        if (sf->var_buf) {
+            for (i = 0; i < b->var_count; i++)
+                tt_add_local(ctx, obj, tdz, &tdz_count,
+                             b->vardefs[b->arg_count + i].var_name, sf->var_buf[i]);
+        }
+    }
+    /* captured (closure) variables */
+    if (p->u.func.var_refs) {
+        for (i = 0; i < b->closure_var_count; i++) {
+            JSVarRef *var_ref = p->u.func.var_refs[i];
+            if (var_ref && var_ref->pvalue)
+                tt_add_local(ctx, obj, tdz, &tdz_count,
+                             b->closure_var[i].var_name, *var_ref->pvalue);
+        }
+    }
+    JS_DefinePropertyValueStr(ctx, obj, "<uninitialized>", tdz, JS_PROP_C_W_E);
+    return obj;
+}
+
+/* Restrict step hooks to functions compiled from `filename` (NULL = all). */
+void JS_TTSetStepFilename(JSContext *ctx, const char *filename)
+{
+    JSRuntime *rt = ctx->rt;
+    if (rt->tt_step_filename != JS_ATOM_NULL)
+        JS_FreeAtomRT(rt, rt->tt_step_filename);
+    rt->tt_step_filename = filename ? JS_NewAtom(ctx, filename) : JS_ATOM_NULL;
+}
+
+/* Script-level let/const/class bindings live in ctx->global_var_obj, not on
+   globalThis. Returns a plain object copy: { name -> value }, TDZ bindings
+   listed under "<uninitialized>". */
+JSValue JS_TTGlobalLexicals(JSContext *ctx)
+{
+    JSValue obj, tdz;
+    JSPropertyEnum *tab;
+    uint32_t len, i, tdz_count = 0;
+    JSObject *p;
+
+    obj = JS_NewObject(ctx);
+    if (JS_IsException(obj))
+        return obj;
+    tdz = JS_NewArray(ctx);
+    if (JS_VALUE_GET_TAG(ctx->global_var_obj) != JS_TAG_OBJECT)
+        goto done;
+    p = JS_VALUE_GET_OBJ(ctx->global_var_obj);
+    if (JS_GetOwnPropertyNamesInternal(ctx, &tab, &len, p, JS_GPN_STRING_MASK))
+        goto done;
+    for (i = 0; i < len; i++) {
+        JSValue v = JS_GetPropertyInternal(ctx, ctx->global_var_obj,
+                                           tab[i].atom, ctx->global_var_obj, 0);
+        if (JS_IsException(v)) {
+            JS_FreeValue(ctx, JS_GetException(ctx));
+            continue;
+        }
+        tt_add_local(ctx, obj, tdz, &tdz_count, tab[i].atom, v);
+        JS_FreeValue(ctx, v);
+    }
+    JS_FreePropertyEnum(ctx, tab, len);
+ done:
+    JS_DefinePropertyValueStr(ctx, obj, "<uninitialized>", tdz, JS_PROP_C_W_E);
+    return obj;
+}
