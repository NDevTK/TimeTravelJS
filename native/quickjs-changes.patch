+/* Like find_line_num, but also reports the bytecode range [*ppc_lo, *ppc_hi)
+   over which the resolved line holds, so the dispatch loop can skip hook
+   checks while execution stays on the same line. */
+static int tt_find_line(JSFunctionBytecode *b, uint32_t pc_value,
+                        int *pcol_num, uint32_t *ppc_lo, uint32_t *ppc_hi)
+{
+    const uint8_t *p_end, *p;
+    int new_line_num, line_num, v, ret, new_col_num, col_num;
+    uint32_t val, pc, prev_pc;
+    unsigned int op;
+
+    *ppc_lo = 0;
+    *ppc_hi = UINT32_MAX;
+    if (!b->has_debug || !b->debug.pc2line_buf)
+        goto fail;
+
+    p = b->debug.pc2line_buf;
+    p_end = p + b->debug.pc2line_len;
+
+    ret = get_leb128(&val, p, p_end);
+    if (ret < 0)
+        goto fail;
+    p += ret;
+    line_num = val + 1;
+
+    ret = get_leb128(&val, p, p_end);
+    if (ret < 0)
+        goto fail;
+    p += ret;
+    col_num = val + 1;
+
+    pc = 0;
+    prev_pc = 0;
+    while (p < p_end) {
+        op = *p++;
+        if (op == 0) {
+            ret = get_leb128(&val, p, p_end);
+            if (ret < 0)
+                goto fail;
+            pc += val;
+            p += ret;
+            ret = get_sleb128(&v, p, p_end);
+            if (ret < 0)
+                goto fail;
+            p += ret;
+            new_line_num = line_num + v;
+        } else {
+            op -= PC2LINE_OP_FIRST;
+            pc += (op / PC2LINE_RANGE);
+            new_line_num = line_num + (op % PC2LINE_RANGE) + PC2LINE_BASE;
+        }
+        ret = get_sleb128(&v, p, p_end);
+        if (ret < 0)
+            goto fail;
+        p += ret;
+        new_col_num = col_num + v;
+
+        if (pc_value < pc) {
+            *ppc_lo = prev_pc;
+            *ppc_hi = pc;
+            goto done;
+        }
+        prev_pc = pc;
+        line_num = new_line_num;
+        col_num = new_col_num;
+    }
+    *ppc_lo = prev_pc;
+ done:
+    *pcol_num = col_num;
+    return line_num;
+ fail:
+    *pcol_num = 0;
+    return 0;
+}
+
+/* Called from the dispatch loop whenever stepping is enabled. Fires the host
+   step handler on line changes and backward jumps (loop iterations).
+   Returns nonzero to abort execution like an interrupt. */
+static no_inline int js_tt_step_check(JSContext *ctx, JSStackFrame *sf,
+                                      JSFunctionBytecode *b, const uint8_t *pc)
+{
+    JSRuntime *rt = ctx->rt;
+    uint32_t off = (uint32_t)(pc - b->byte_code_buf);
+    int col, line, depth;
+    JSStackFrame *f;
+
+    if (!rt->tt_step_handler || !b->has_debug)
+        return 0;
+    if (rt->tt_step_filename != JS_ATOM_NULL &&
+        b->debug.filename != rt->tt_step_filename)
+        return 0;
+    if (off >= sf->tt_pc_lo && off < sf->tt_pc_hi && sf->tt_pc_hi != 0) {
+        if (off >= sf->tt_prev_off) {
+            /* forward progress on the same line */
+            sf->tt_prev_off = off;
+            return 0;
+        }
+        /* backward jump within the same line: new loop iteration */
+        line = sf->tt_last_line;
+        tt_find_line(b, off, &col, &sf->tt_pc_lo, &sf->tt_pc_hi);
+    } else {
+        line = tt_find_line(b, off, &col, &sf->tt_pc_lo, &sf->tt_pc_hi);
+        if (line <= 0)
+            return 0;
+        if (line == sf->tt_last_line && off >= sf->tt_prev_off) {
+            /* forward move into a different range of the same line
+               (e.g. multi-range statements): not a new step */
+            sf->tt_prev_off = off;
+            return 0;
+        }
+    }
+    sf->tt_prev_off = off;
+    sf->tt_last_line = line;
+    sf->cur_pc = pc; /* keep backtraces honest while paused here */
+
+    depth = 0;
+    for (f = rt->current_stack_frame; f; f = f->prev_frame)
+        depth++;
+    if (tt_vtime_enabled)
+        tt_vtime += 1;
+    return rt->tt_step_handler(ctx, line, col, depth - 1, rt->tt_step_opaque);
+}
