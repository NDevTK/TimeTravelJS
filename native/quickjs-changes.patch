+/* TimeTravelJS ----------------------------------------------------------- */
+
+/* Deterministic virtual clock. Lives in the data segment (linear memory),
+   so wasm heap snapshots capture and restore it automatically. */
+static int tt_vtime_enabled;
+static double tt_vtime;
